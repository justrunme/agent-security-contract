FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY policy ./policy
COPY schemas ./schemas

RUN pip install --no-cache-dir .

EXPOSE 8788
CMD ["python", "-m", "asc.sidecar", "--policy", "/app/policy/demo-agent.policy.yaml", "--host", "0.0.0.0", "--port", "8788"]
