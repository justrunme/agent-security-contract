FROM python:3.12-slim

WORKDIR /app
COPY examples/external-auth/ext_authz_adapter.py /app/ext_authz_adapter.py

ENV HOST=0.0.0.0
ENV PORT=9191
ENV ASC_EVALUATE_URL=http://127.0.0.1:8788/v1/evaluate
ENV ASC_TIMEOUT_S=0.5
ENV ASC_DEMO_BEARER=asc-demo

EXPOSE 9191
CMD ["python", "/app/ext_authz_adapter.py"]
